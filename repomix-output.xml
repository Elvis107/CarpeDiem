  width: 420px;
  height: 420px;
  top: -120px;
  left: -100px;
  background: rgba(34, 211, 238, 0.16);
}
.login-glow-indigo {
  width: 480px;
  height: 480px;
  bottom: -160px;
  right: -120px;
  background: rgba(99, 102, 241, 0.16);
}

/* ---------- Tarjeta ---------- */
.login-box {
  position: relative;
  z-index: 1;
  background: var(--surface);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
