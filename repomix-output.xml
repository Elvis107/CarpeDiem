                  className="flex-1 py-3.5 rounded-xl text-white font-semibold bg-[#00b4d8] hover:bg-[#0096b4] disabled:bg-gray-700 disabled:text-gray-400 shadow-lg shadow-[#00b4d8]/20 transition-all text-base"
