import { useEffect, useState } from "react";
import { Icon } from "@iconify/react";
import { supabase } from "../supabaseClient";

export default function HistorialReportes({ onClose }) {
  const [historial, setHistorial] = useState([]);
  const [loading, setLoading] = useState(true);

  const [resumen, setResumen] = useState({
    ingresos: 0,
    egresos: 0,
    enServicio: 0,
    recaudacion: 0,
  });

  const [filtro, setFiltro] = useState("todos");
  const cargarHistorial = async () => {
    setLoading(true);

    /*obtener vehiculos con ingresos*/
    const {
      data: ingresos,
      error: errorIngresos,
    } = await supabase
      .from("ingreso")
      .select(`
        id_ingreso,
        patente,
        fecha_ingreso,
        hora_ingreso,
        vehiculo (
          categoria_vehiculo (
            nombre_categoria,
            valor_hora
          )
        )
      `)
      .order("fecha_ingreso", {
        ascending: false,
      });

    /*OBTENER TODAS LAS SALIDAS*/
    const {
      data: salidas,
      error: errorSalidas,
    } = await supabase
      .from("salida")
      .select(`
        id_salida,
        id_ingreso,
        fecha_salida,
        hora_salida,
        tiempo_total,
        costo_total
      `)
      .order("fecha_salida", {
        ascending: false,
      });

    if (errorIngresos || errorSalidas) {
      console.error("Error cargando historial:", {
        errorIngresos,
        errorSalidas,
      });

      setLoading(false);
      return;
    }

    const historialCompleto = (salidas || [])
      .map((salida) => {
        const ingreso = (ingresos || []).find(
          (i) => i.id_ingreso === salida.id_ingreso
        );

        if (!ingreso) {
          return null;
        }

        return {
          ...salida,
          patente: ingreso.patente,
          fecha_ingreso: ingreso.fecha_ingreso,
          hora_ingreso: ingreso.hora_ingreso,
          categoria:
            ingreso.vehiculo?.categoria_vehiculo
              ?.nombre_categoria || "Sin categoría",
          valorHora:
            ingreso.vehiculo?.categoria_vehiculo
              ?.valor_hora || 0,
        };
      })
      .filter(Boolean);

    setHistorial(historialCompleto);

    const idsIngresos = new Set(
      (ingresos || []).map(
        (ingreso) => ingreso.id_ingreso
      )
    );

    const idsSalidas = new Set(
      (salidas || []).map(
        (salida) => salida.id_ingreso
      )
    );

    const vehiculosEnServicio = [
      ...idsIngresos,
    ].filter(
      (idIngreso) =>
        !idsSalidas.has(idIngreso)
    ).length;

    const totalIngresos =
      ingresos?.length || 0;

    const totalEgresos =
      salidas?.length || 0;

    const totalRecaudacion =
      (salidas || []).reduce(
        (total, salida) =>
          total +
          Number(
            salida.costo_total || 0
          ),
        0
      );

    setResumen({
      ingresos: totalIngresos,
      egresos: totalEgresos,
      enServicio: vehiculosEnServicio,
      recaudacion: totalRecaudacion,
    });

    setLoading(false);
  };

  useEffect(() => {
    cargarHistorial();

    const canal = supabase
      .channel("historial-reportes")

      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "ingreso",
        },
        () => {
          cargarHistorial();
        }
      )

      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "salida",
        },
        () => {
          cargarHistorial();
        }
      )

      .subscribe();

    return () => {
      supabase.removeChannel(canal);
    };
  }, []);

  /*filtrar informacion por categoria*/
  const historialFiltrado =
    filtro === "todos"
      ? historial
      : historial.filter(
          (vehiculo) =>
            vehiculo.categoria.toLowerCase() ===
            filtro.toLowerCase()
        );

  const formatearFecha = (fecha) => {
    if (!fecha) return "—";

    const [year, month, day] =
      fecha.split("-");

    return `${day}-${month}-${year}`;
  };

  const formatearTiempo = (tiempo) => {
    if (!tiempo) {
      return "00:00:00";
    }

    return tiempo
      .toString()
      .split(".")[0];
  };

  return (
    <div className="flex min-h-0 w-full min-w-0 flex-1 flex-col overflow-hidden rounded-none border border-slate-200/80 bg-gradient-to-b from-white via-white to-slate-50 shadow-[0_20px_60px_rgba(15,23,42,0.08)]">
      <div className="shrink-0 border-b border-slate-200/80 bg-white/90 px-6 py-5 backdrop-blur sm:px-8 sm:py-6">
        <div className="flex items-start justify-between gap-4">
