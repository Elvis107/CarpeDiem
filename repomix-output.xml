/* ---------- Fondo: retícula de sensores en vez de foto stock ---------- */
.login-container {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  overflow: hidden;
  background: var(--void);
}

.login-container::before {
  /* Retícula de "bahías" de estacionamiento */
  content: "";
  position: absolute;
  inset: -10%;
  background-image:
    linear-gradient(rgba(99, 102, 241, 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(99, 102, 241, 0.08) 1px, transparent 1px);
  background-size: 46px 46px;
  mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 30%, transparent 75%);
  animation: gridDrift 40s linear infinite;
}

.login-container::after {
  /* Barrido tipo radar / sensor ultrasónico */
  content: "";
  position: absolute;
  width: 140vmax;
  height: 140vmax;
  top: 50%;
  left: 50%;
  background: conic-gradient(from 0deg, transparent 0deg, rgba(34, 211, 238, 0.10) 8deg, transparent 40deg);
  transform: translate(-50%, -50%);
  animation: radarSweep 9s linear infinite;
}

@keyframes gridDrift {
  from { background-position: 0 0, 0 0; }
  to   { background-position: 46px 46px, 46px 46px; }
}

@keyframes radarSweep {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to   { transform: translate(-50%, -50%) rotate(360deg); }
}

.login-glow-cyan,
.login-glow-indigo {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  pointer-events: none;
}
