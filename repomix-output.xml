import { useEffect, useState } from "react";
import { Icon } from "@iconify/react";
import { supabase } from "../supabaseClient";
import { useNavigate } from "react-router-dom";

import "bootstrap/dist/css/bootstrap.min.css";

export default function ParkingInfo() {
    const navigate = useNavigate();

    const [availableSpaces, setAvailableSpaces] = useState(32);
    const [menuOpen, setMenuOpen] = useState(false);

    const totalSpaces = 32;
    const occupiedSpaces = totalSpaces - availableSpaces;

    const occupancyPercentage =
        totalSpaces > 0
            ? Math.round((occupiedSpaces / totalSpaces) * 100)
            : 0;

    useEffect(() => {
        const loadAvailability = async () => {
            try {
            } catch (error) {
                console.error(
                    "Error al obtener disponibilidad:",
                    error
                );
            }
        };

        loadAvailability();
    }, []);

    const scrollToSection = (id) => {
        document.getElementById(id)?.scrollIntoView({
            behavior: "smooth",
        });

        setMenuOpen(false);
    };

    return (
        <div className="bg-light min-vh-100">

            <nav className="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
                <div className="container py-2">

                    <button
                        type="button"
                        className="navbar-brand d-flex align-items-center border-0 bg-transparent p-0"
                        onClick={() => scrollToSection("inicio")}
                    >
                        <div
                            className="d-flex align-items-center justify-content-center bg-success rounded-3 me-2"
                            style={{
                                width: "42px",
                                height: "42px",
                            }}
                        >
                            <Icon
                                icon="mdi:parking"
                                width="25"
                                className="text-white"
                            />
                        </div>

                        <div className="text-start">
                            <div className="fw-bold text-dark">
                                CARPE DIEM
                            </div>

                            <small
                                className="text-muted"
                                style={{
                                    fontSize: "0.65rem",
                                }}
                            >
                                SMART PARKING
                            </small>
                        </div>
                    </button>

                    <button
                        type="button"
                        className="navbar-toggler border-0"
                        onClick={() => setMenuOpen(!menuOpen)}
                        aria-label="Abrir menú"
                        aria-expanded={menuOpen}
                    >
                        <Icon
                            icon={
                                menuOpen
                                    ? "line-md:close"
                                    : "line-md:menu"
                            }
                            width="28"
                        />
                    </button>

                    <div
                        className={`navbar-collapse ${
                            menuOpen ? "show" : ""
                        }`}
                    >
                        <ul className="navbar-nav mx-auto gap-lg-3">

                            <li className="nav-item">
                                <button
                                    type="button"
                                    className="nav-link border-0 bg-transparent"
                                    onClick={() =>
                                        scrollToSection("inicio")
                                    }
                                >
                                    Inicio
                                </button>
                            </li>

                            <li className="nav-item">
                                <button
                                    type="button"
                                    className="nav-link border-0 bg-transparent"
                                    onClick={() =>
                                        scrollToSection(
                                            "disponibilidad"
                                        )
                                    }
                                >
                                    Disponibilidad
                                </button>
                            </li>

                            <li className="nav-item">
                                <button
                                    type="button"
                                    className="nav-link border-0 bg-transparent"
                                    onClick={() =>
                                        scrollToSection("tarifas")
                                    }
                                >
                                    Tarifas
                                </button>
                            </li>

                            <li className="nav-item">
                                <button
                                    type="button"
                                    className="nav-link border-0 bg-transparent"
                                    onClick={() =>
                                        scrollToSection("ubicacion")
                                    }
                                >
                                    Ubicación
