.login-box h1 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1.9rem;
  font-weight: 700;
  text-align: center;
  letter-spacing: -0.01em;
  line-height: 1.15;
  margin-bottom: 0.35rem;
  background: linear-gradient(90deg, var(--cyan), var(--indigo));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.login-subtitle {
  text-align: center;
  font-size: 0.8rem;
  color: var(--text-mid);
  margin-bottom: 1.5rem;
}

/* ---------- Firma visual: franja de sensores de plaza ---------- */
.sensor-strip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-bottom: 1.75rem;
}

.sensor-strip__slot {
  width: 22px;
  height: 8px;
  border-radius: 3px;
  background: rgba(148, 163, 184, 0.16);
  border: 1px solid rgba(148, 163, 184, 0.22);
}

.sensor-strip__slot--active {
  background: var(--cyan);
  border-color: var(--cyan);
  box-shadow: 0 0 10px rgba(34, 211, 238, 0.7);
  animation: sensorPulse 2.2s ease-in-out infinite;
}

.sensor-strip__label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.62rem;
  letter-spacing: 0.04em;
  color: var(--text-low);
  margin-left: 8px;
  white-space: nowrap;
}

@keyframes sensorPulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 10px rgba(34, 211, 238, 0.7); }
  50% { opacity: 0.55; box-shadow: 0 0 4px rgba(34, 211, 238, 0.3); }
}

/* ---------- Banners ---------- */
.banner-success {
  display: flex;
  align-items: center;
  gap: 8px;
  background-color: rgba(52, 211, 153, 0.1);
  border: 1px solid rgba(52, 211, 153, 0.3);
  border-radius: 10px;
  padding: 10px 14px;
  font-size: 0.78rem;
  color: var(--success);
  margin-bottom: 1rem;
}

.banner-error {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background-color: rgba(248, 113, 113, 0.1);
  border: 1px solid rgba(248, 113, 113, 0.3);
  border-radius: 10px;
  padding: 10px 14px;
  font-size: 0.78rem;
  color: var(--danger);
  margin-bottom: 1rem;
  text-align: center;
}

/* ---------- Campos ---------- */
.field {
  margin-bottom: 1.15rem;
  position: relative;
}

.field-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.field-wrap .field-icon-leading {
  position: absolute;
  left: 14px;
  color: var(--text-low);
  pointer-events: none;
  display: flex;
}

.field input {
  width: 100%;
  height: 46px;
  padding: 0 14px 0 42px;
  font-size: 0.875rem;
  font-family: 'Inter', sans-serif;
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  outline: none;
  background: rgba(5, 8, 15, 0.5);
  color: var(--text-hi);
  transition: border-color 0.15s, box-shadow 0.15s;
}

.field input::placeholder {
  color: var(--text-low);
}

.field input:focus {
  border-color: var(--cyan);
  box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.12);
}

.field input.input-error {
  border-color: var(--danger);
}

.field input.input-error:focus {
  box-shadow: 0 0 0 3px rgba(248, 113, 113, 0.14);
}

.field input[type="password"],
.field input[data-has-toggle="true"] {
  padding-right: 42px;
}

.field .field-icon-trailing {
  position: absolute;
  right: 12px;
  color: var(--text-low);
  background: none;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  padding: 4px;
  transition: color 0.15s;
}

.field .field-icon-trailing:hover {
  color: var(--text-mid);
}

.field .error-msg {
  font-size: 0.7rem;
  color: var(--danger);
  margin-top: 5px;
  padding-left: 2px;
}

/* ---------- Fila remember + forgot ---------- */
.row-options {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.5rem;
  font-size: 0.78rem;
}

.row-options label {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--text-mid);
  cursor: pointer;
  user-select: none;
}

.row-options input[type="checkbox"] {
  accent-color: var(--cyan);
  width: 14px;
  height: 14px;
}

.btn-forgot {
  background: none;
  border: none;
  color: var(--text-mid);
  font-size: 0.78rem;
  font-weight: 500;
  cursor: pointer;
  transition: color 0.15s;
  padding: 0;
}

.btn-forgot:hover {
  color: var(--cyan);
}

/* ---------- Botón submit ---------- */
.btn-primary {
  width: 100%;
  height: 46px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: linear-gradient(90deg, var(--cyan), var(--indigo));
  color: #05070d;
  border: none;
  border-radius: 12px;
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.01em;
  cursor: pointer;
  transition: opacity 0.15s, transform 0.1s;
  margin-bottom: 0.25rem;
}

.btn-primary:hover {
  opacity: 0.92;
}

.btn-primary:active {
  transform: scale(0.98);
}

.btn-primary:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}
</file>

